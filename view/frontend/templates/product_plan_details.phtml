<?php
/**
 * Loader/dispatcher for the Nuvei plan details table.
 *
 * Renders a different partial depending on the active frontend theme:
 * - Hyvä: product_plan_details_hyva.phtml (Tailwind-styled markup + fetch/Alpine script)
 * - Luma: product_plan_details_luma.phtml (plain markup + jQuery script)
 *
 * @var $block \Nuvei\Checkout\Block\Frontend\Product\NuveiPlanDetails
 */

if (1 == $block->isProductWithPlan()) :
    $isHyva = \Magento\Framework\App\ObjectManager::getInstance()
        ->get(\Magento\Framework\Module\Manager::class)
        ->isEnabled('Hyva_Theme');

    $nuveiPlanTpl = $isHyva ? 'Nuvei_Checkout::product_plan_details_hyva.phtml'
        : 'Nuvei_Checkout::product_plan_details_luma.phtml';

    echo $block->fetchView($block->getTemplateFile($nuveiPlanTpl));
endif;
