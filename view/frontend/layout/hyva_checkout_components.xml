<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="checkout.payment.methods">
            <block name="checkout.payment.method.nuvei_data"
                   as="nuvei"
                   template="Nuvei_Checkout::hyva_checkout/payment/nuvei_data.phtml">
            </block>
        </referenceBlock>
        
        <!-- the container for Nuvei checkout -->
        <referenceBlock name="checkout.payment.methods.after">
            <block name="checkout.payment.method.nuvei_card"
                   as="nuvei"
                   template="Nuvei_Checkout::hyva_checkout/payment/nuvei_card.phtml">
            </block>
        </referenceBlock>
        
        <!-- The place to load Simply Connect SDK. This place is loaded once per page. -->
        <referenceContainer name="hyva.checkout.api-v1.after">
            <block name="hyva.checkout.payment.method.js.api.v1.nuvei_app"
                   template="Nuvei_Checkout::hyva_checkout/payment/js/api/v1/nuvei_app.phtml">
            </block>
        </referenceContainer>
    </body>
</page>